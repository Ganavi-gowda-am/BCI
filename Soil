#define MOISTURE_SENSOR_PIN 36  // GPIO36 - ADC1_0
#define RELAY_PIN 26            // Relay control pin
#define LED_PIN 25              // Optional LED indicator

int threshold = 2500;           // Adjust based on soil calibration
bool solenoidState = false;

void setup() {
  Serial.begin(115200);
  pinMode(MOISTURE_SENSOR_PIN, INPUT);
  pinMode(RELAY_PIN, OUTPUT);
  pinMode(LED_PIN, OUTPUT);

  digitalWrite(RELAY_PIN, LOW);  // Solenoid off initially
  digitalWrite(LED_PIN, LOW);    // LED off
}

void loop() {
  int moistureValue = analogRead(MOISTURE_SENSOR_PIN);
  Serial.print("Moisture Level: ");
  Serial.println(moistureValue);

  if (moistureValue < threshold && !solenoidState) {
    solenoidState = true;
    digitalWrite(RELAY_PIN, HIGH);   // Activate relay
    digitalWrite(LED_PIN, HIGH);     // Turn on LED
    Serial.println("Relay ON - Watering...");
  } else if (moistureValue >= threshold && solenoidState) {
    solenoidState = false;
    digitalWrite(RELAY_PIN, LOW);    // Deactivate relay
    digitalWrite(LED_PIN, LOW);      // Turn off LED
    Serial.println("Relay OFF - Moisture Adequate");
  }

  delay(1000);  // Sampling interval
}
