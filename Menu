import tkinter as tk
from tkinter import messagebox
import datetime

# Menu dictionary
menu = {
    "Pizza": 400,
    "Pasta": 150,
    "Salad": 120,
    "Coffee": 50
}

order_list = {}  # {item: qty}

# Add item to order
def add_item(item):
    qty = qty_vars[item].get()
    if qty > 0:
        order_list[item] = order_list.get(item, 0) + qty
        update_bill()
    else:
        messagebox.showwarning("Invalid Quantity", "Quantity must be at least 1.")

# Remove item from order
def remove_item(item):
    if item in order_list:
        del order_list[item]
        update_bill()
    else:
        messagebox.showwarning("Not Found", f"{item} is not in your order.")

# Update bill display
def update_bill():
    bill_text.delete("1.0", tk.END)
    subtotal = sum(menu[item] * qty for item, qty in order_list.items())
    tax_rate = 0.05
    discount_rate = 0.1 if subtotal > 500 else 0
    tax_amount = subtotal * tax_rate
    discount_amount = subtotal * discount_rate
    total_amount = subtotal + tax_amount - discount_amount

    bill_text.insert(tk.END, "🧾 BILL RECEIPT\n")
    bill_text.insert(tk.END, "=" * 30 + "\n")
    for item, qty in order_list.items():
        bill_text.insert(tk.END, f"{item:<10} x{qty:<3} ₹{menu[item] * qty}\n")
    bill_text.insert(tk.END, "-" * 30 + "\n")
    bill_text.insert(tk.END, f"Subtotal: ₹{subtotal}\n")
    bill_text.insert(tk.END, f"GST (5%): ₹{tax_amount:.2f}\n")
    if discount_rate > 0:
        bill_text.insert(tk.END, f"Discount (10%): -₹{discount_amount:.2f}\n")
    bill_text.insert(tk.END, "=" * 30 + "\n")
    bill_text.insert(tk.END, f"TOTAL: ₹{total_amount:.2f}\n")

# Save bill to file
def save_bill():
    if not order_list:
        messagebox.showwarning("Empty Bill", "No items to save.")
        return
    filename = f"Bill_{datetime.datetime.now().strftime('%Y%m%d_%H%M%S')}.txt"
    with open(filename, "w") as file:
        file.write(bill_text.get("1.0", tk.END))
    messagebox.showinfo("Bill Saved", f"Bill saved as {filename}")

# GUI setup
root = tk.Tk()
root.title("Restaurant Billing System")
root.geometry("500x500")

tk.Label(root, text="🍽️ Restaurant Menu", font=("Arial", 16, "bold")).pack()

# Menu frame
menu_frame = tk.Frame(root)
menu_frame.pack()

qty_vars = {}
for item, price in menu.items():
    frame = tk.Frame(menu_frame)
    frame.pack(anchor="w", pady=5)
    tk.Label(frame, text=f"{item} - ₹{price}", width=20, anchor="w").pack(side=tk.LEFT)
    qty_vars[item] = tk.IntVar(value=1)
    tk.Entry(frame, textvariable=qty_vars[item], width=5).pack(side=tk.LEFT)
    tk.Button(frame, text="Add", command=lambda i=item: add_item(i)).pack(side=tk.LEFT, padx=5)
    tk.Button(frame, text="Remove", command=lambda i=item: remove_item(i)).pack(side=tk.LEFT)

# Bill area
bill_text = tk.Text(root, height=15, width=50)
bill_text.pack(pady=10)

# Buttons
btn_frame = tk.Frame(root)
btn_frame.pack()
tk.Button(btn_frame, text="Save Bill", command=save_bill, bg="green", fg="white").pack(side=tk.LEFT, padx=5)
tk.Button(btn_frame, text="Exit", command=root.destroy, bg="red", fg="white").pack(side=tk.LEFT, padx=5)

root.mainloop()
